# =====================================================================================
#  ShopEase container settings - externalised configuration
#
#  Copy to shopease.env, fill in the secrets, then:   chmod 600 shopease.env
#  Use with:  podman run --env-file shopease.env ...   (or docker run --env-file ...)
#  Never commit the filled-in copy. Values are taken literally: no quotes, no spaces around "=".
#  Lines starting with # are comments; a variable left out falls back to its default.
# =====================================================================================

# ---- Database container (mariadb:11.4 / mysql:8.4 image) ------------------------------
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=shopease
MYSQL_USER=shopease
MYSQL_PASSWORD=change-me-db

# ---- Tomcat JNDI DataSource jdbc/ShopEaseDB  (server.xml placeholders) ------------------
# Host "shopease-db" = the database container's name on the shared Podman/Docker network.
DB_URL=jdbc:mysql://shopease-db:3306/shopease?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=shopease
# must equal MYSQL_PASSWORD above
DB_PASSWORD=change-me-db
#DB_POOL_MAX=10
#DB_POOL_MIN_IDLE=2
#DB_POOL_CONNECTION_TIMEOUT_MS=10000

# ---- Tomcat HTTP connector  (server.xml placeholders) -----------------------------------
#TOMCAT_HTTP_PORT=8080
#TOMCAT_MAX_THREADS=200
#TOMCAT_MIN_SPARE_THREADS=10
#TOMCAT_ACCEPT_COUNT=100
#TOMCAT_CONNECTION_TIMEOUT=20000
#TOMCAT_MAX_POST_SIZE=10485760

# ---- Application  (any app.properties key in UPPER_SNAKE_CASE) --------------------------
APP_ADMIN_EMAIL=admin@shopease.com
APP_ADMIN_PASSWORD=change-me-admin
#APP_DB_INIT=true
#APP_STORE_NAME=ShopEase
#APP_TAX_RATE=0.18
# camelCase keys are only upper-cased, not split: app.shipping.freeThreshold -> APP_SHIPPING_FREETHRESHOLD
#APP_SHIPPING_FREETHRESHOLD=999
#APP_SHIPPING_FLATFEE=49
#APP_CATALOG_PAGESIZE=12

# ---- JVM / container ---------------------------------------------------------------------
#TZ=Asia/Kolkata
#JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8
