# Copy to .env (same folder as docker-compose.yml) and change the passwords:  cp .env.example .env
# docker compose / podman-compose read .env automatically. Never commit the real .env.

# PostgreSQL password - used by the db container and by Tomcat's JNDI pool
POSTGRES_PASSWORD=change-me-db

# ShopEase administrator account, created on first start
APP_ADMIN_EMAIL=admin@shopease.com
APP_ADMIN_PASSWORD=change-me-admin

# Host port for the shop (container port is 8080)
HTTP_PORT=8081

# Time zone for Tomcat and PostgreSQL logs
TZ=Asia/Kolkata
